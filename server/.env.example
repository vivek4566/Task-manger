# Copy to .env on your machine or EC2: cp .env.example .env

# MongoDB (Atlas recommended for EC2)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/taskmanager?retryWrites=true&w=majority

# Strong random string (required in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Server
PORT=5000
NODE_ENV=production

# Comma-separated browser origins (no trailing slash)
# Example EC2: http://3.120.45.67,http://3.120.45.67:80
CLIENT_ORIGIN=http://localhost:3000,http://localhost
